# ============================================================
# .gitignore — Files and directories excluded from git
# ============================================================

# ── Secrets (CRITICAL) ────────────────────────────────────────────────────────
# Environment files may contain SECRET_KEY, DB_PASSWORD, and other credentials.
# Ignore every environment-specific variant while retaining the reviewed template.
.env*
!/.env.example

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Trained model weights ─────────────────────────────────────────────────────
# PyTorch .pth files are large binary files (100MB+).
# Training happens on the host machine; weights are NOT stored in git.
# The weights/ directory exists in git via .gitkeep files.
apps/cv/weights/*.pth
# Backup copies made before overwriting weights during retraining — same
# reasoning as *.pth above (large, host-local, not reproducible in git).
apps/cv/weights/*.pth.bak

# ── Django collected static / uploaded media ──────────────────────────────────
# 'static/' is SOURCE (CSS, JS) — committed to git.
# 'staticfiles/' is the collectstatic OUTPUT — a build artifact, not committed.
/staticfiles/
# Ignore uploaded media files but keep the placeholder so the directory exists in git.
# The two-step pattern (un-ignore directory, then un-ignore file) is required because
# git cannot un-ignore a file inside an ignored parent directory.
/media/**
!/media/plates/
!/media/plates/.gitkeep

# ── Testing and coverage ──────────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/

# ── Virtual environments ──────────────────────────────────────────────────────
# If running outside Docker, virtual environments stay local.
venv/
.venv/
env/

# ── IDE and OS files ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
# Compose creates these — not source files.
*.log

# ── Analysis artifacts ────────────────────────────────────────────────────────
graphify-out/

# ── Reviewed documentation proof ──────────────────────────────────────────────
# Proof runs may contain real plates, timestamps, charges, or operator details.
# Ignore new captures by default and allowlist only sanitized README assets.
artifacts/dashboard-proof/*
!artifacts/dashboard-proof/01-login.png
!artifacts/dashboard-proof/02-entry-detected.png
!artifacts/dashboard-proof/03-dashboard-active.png
!artifacts/dashboard-proof/04-exit-completed.png
!artifacts/dashboard-proof/05-session-log.png
!artifacts/dashboard-proof/06-error-queue.png
!artifacts/dashboard-proof/07-revenue.png

# ── Local documentation (not pushed) ───────────────────────────────────────────
docs/

# ── AI agent instructions (local only) ───────────────────────────────────────
AGENTS.md
CLAUDE.md
PLAN.md
.claude/
.claude.md
.superpowers/

# ── Synthetic training data (generated, not committed) ────────────────────────
# Background images are real parking-lot photos supplied by the user.
# Detector/recognizer datasets are generated by synthetic_data.py.
# All are too large and non-reproducible to store in git.
data/backgrounds/*
!data/backgrounds/.gitkeep
data/detector/
data/detector_smoke/
data/recognizer/
# Plate crops dumped for debugging CV preprocessing/pipeline runs — local
# scratch output, not reproducible input, not committed.
data/_debug_crops/

# ── Bundled plate font (binary asset — download per assets/README.md) ─────────
apps/cv/training/assets/*.ttf
apps/cv/training/assets/*.otf
